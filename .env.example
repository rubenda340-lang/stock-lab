# StockLab — Plantilla de variables de entorno
# Copia este archivo a `.env` en local o configura estas variables en
# Streamlit Cloud Secrets / GitHub Actions Secrets / proveedor de hosting.
# NUNCA subas el archivo `.env` real a Git.

# ── Asistente IA (Google Gemini) y Proveedores de Mercado ───────────
STOCKLAB_GEMINI_API_KEY=
STOCKLAB_FMP_API_KEY=
STOCKLAB_FINNHUB_API_KEY=

# ── Fase 2: Autenticación y Base de Datos Multiusuario (Supabase) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo para scripts backend/cron (enviar_alertas.py), NUNCA exponer en cliente:
SUPABASE_SERVICE_ROLE_KEY=

# ── Fase 3: Motor de Alertas por Correo (SMTP Multiusuario o Resend) ─
# Opción A (0 €/mes a CUALQUIER usuario sin dominio): Gmail SMTP (500/día) o Brevo SMTP (300/día)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StockLab Alertas <alertas.stocklab@gmail.com>
# Opción B (fallback o con dominio propio verificado en Resend):
RESEND_API_KEY=
ALERT_FROM_EMAIL=StockLab Alertas <onboarding@resend.dev>
APP_PUBLIC_URL=https://stocklab-terminal.streamlit.app
