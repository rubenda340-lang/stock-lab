# StockLab — Plantilla de variables de entorno
# Copia este archivo a `.env` en local o configura estas variables en
# Streamlit Cloud Secrets / GitHub Actions Secrets / proveedor de hosting.
# NUNCA subas el archivo `.env` real a Git.

# ── Asistente IA (Google Gemini) y Proveedores de Mercado ───────────
STOCKLAB_GEMINI_API_KEY=
STOCKLAB_FMP_API_KEY=
STOCKLAB_FINNHUB_API_KEY=

# ── Fase 2: Autenticación y Base de Datos Multiusuario (Supabase) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo para scripts backend/cron (enviar_alertas.py), NUNCA exponer en cliente:
SUPABASE_SERVICE_ROLE_KEY=

# ── Fase 3: Motor de Alertas por Correo (Resend / Brevo) ────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=StockLab Alertas <alertas@tudominio.com>
APP_PUBLIC_URL=https://stocklab.streamlit.app
